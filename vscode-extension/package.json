{
  "name": "amlog-spider-crawler",
  "displayName": "AMLOG Spider Crawler",
  "description": "Watch what your AI agents actually do: a line-drawn spider follows every read, edit and search (including grep/sed in Bash) live, and each issue gets a shareable agent-trace.json.",
  "version": "0.3.0",
  "publisher": "selise",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/selise/amlog-workflow.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "amlog",
    "agents",
    "visualization",
    "spider",
    "ai"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "amlog.openCrawlMap",
        "title": "AMLOG: Open Crawl Map",
        "icon": "$(globe)"
      },
      {
        "command": "amlog.openCodeCrawl",
        "title": "AMLOG: Open Code Crawl",
        "icon": "$(bug)"
      },
      {
        "command": "amlog.openTraceReplay",
        "title": "AMLOG: Open Trace Replay",
        "icon": "$(history)"
      },
      {
        "command": "amlog.exportTraceHtml",
        "title": "AMLOG: Export Trace as HTML"
      },
      {
        "command": "amlog.toggleDecorations",
        "title": "AMLOG: Toggle Spider Decorations"
      },
      {
        "command": "amlog.clearActivity",
        "title": "AMLOG: Clear Activity"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "amlogActivity",
          "name": "AMLOG Activity",
          "icon": "$(bug)",
          "contextualTitle": "AMLOG Activity"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "amlog.openCodeCrawl",
          "when": "view == amlogActivity",
          "group": "navigation@1"
        },
        {
          "command": "amlog.openCrawlMap",
          "when": "view == amlogActivity",
          "group": "navigation@2"
        },
        {
          "command": "amlog.openTraceReplay",
          "when": "view == amlogActivity",
          "group": "navigation@3"
        },
        {
          "command": "amlog.clearActivity",
          "when": "view == amlogActivity",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "AMLOG Spider Crawler",
      "properties": {
        "amlog.autoRevealOnWrite": {
          "type": "boolean",
          "default": false,
          "description": "Reveal the file in an editor when an agent writes to it."
        },
        "amlog.decorationTtlMs": {
          "type": "number",
          "default": 4000,
          "description": "How long (ms) the spider decoration lingers on a file after a read/write before fading."
        },
        "amlog.showDecorations": {
          "type": "boolean",
          "default": true,
          "description": "Show the gutter spider + line highlight on files agents touch."
        },
        "amlog.trailLength": {
          "type": "number",
          "default": 8,
          "description": "How many recently touched files each agent's silk trail connects in the crawl map."
        },
        "amlog.captureSource": {
          "type": "string",
          "enum": [
            "transcript",
            "hook"
          ],
          "default": "transcript",
          "enumDescriptions": [
            "Read the Claude Code session transcripts (full detail: Bash reads/searches, exact lines, captions, tokens). The hook file is used only for sessions without a transcript.",
            "Only use the PostToolUse hook file (.amlog/activity/events.ndjson)."
          ],
          "description": "Where agent activity is captured from. Reload the window after changing."
        },
        "amlog.sessionLookbackMinutes": {
          "type": "number",
          "default": 60,
          "description": "On startup, replay Claude Code sessions active within this many minutes (into the recap and trace)."
        },
        "amlog.writeTraceFile": {
          "type": "boolean",
          "default": true,
          "description": "Write each session into docs/<issue>/agent-trace.json (the folder holding the issue instructions.md / plan.md), or .amlog/traces/ when no issue folder is found."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies",
    "pack:vsix": "npm run compile && node scripts/pack-vsix.js"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.84.0",
    "@vscode/vsce": "^2.32.0",
    "typescript": "^5.4.0",
    "yazl": "^2.5.1"
  }
}
